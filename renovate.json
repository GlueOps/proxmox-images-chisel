{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned chisel image (tag + digest) in the packer template",
      "fileMatch": ["(^|/)qemu\\.pkr\\.hcl$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*default\\s*=\\s*\"[^\"]*:(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    }
  ]
}
